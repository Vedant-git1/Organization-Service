# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=organization-service

# Database (MySQL 8)
DATABASE_URL=mysql://resolve_user:resolve_password@localhost:3307/resolve_organization

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Phase 3 security (use secrets managed outside source control)
JWT_SECRET=replace-with-at-least-32-character-development-secret
JWT_ISSUER=resolve-authentication
JWT_AUDIENCE=
INTERNAL_AUTH_SECRET=replace-with-at-least-32-character-internal-secret
INTERNAL_ALLOWED_SERVICES=authentication-service,user-service
SYSTEM_ADMIN_USER_IDS=